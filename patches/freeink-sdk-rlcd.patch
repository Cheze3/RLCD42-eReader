diff --git a/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp b/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp
new file mode 100644
index 0000000..e7c66e3
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/St7305Driver.cpp
@@ -0,0 +1,171 @@
+#include "St7305Driver.h"
+
+#if FREEINK_DRIVER_ST7305
+
+#include <esp_heap_caps.h>
+
+namespace freeink {
+
+namespace {
+
+constexpr spi_host_device_t kHost = SPI3_HOST;  // SPI2 is Arduino's default `SPI`; SD is SDMMC.
+
+struct InitStep {
+  uint8_t cmd;
+  uint8_t len;
+  uint8_t data[10];
+  uint16_t delayAfterMs;
+};
+
+// Waveshare's initialization sequence for the 4.2" panel (power, timing and panel registers,
+// sleep out, 4-pixel-block data format, inversion on, GRAM window for 15,000 bytes, tearing
+// effect line on, high power mode, display on). Taken from the hardware-verified
+// `waveshare_rlcd_42` preset of the st7305-lcd crate, which follows Waveshare's own BSP.
+constexpr InitStep kInit[] = {
+    {0xD6, 2, {0x17, 0x02}, 0},
+    {0xD1, 1, {0x01}, 0},
+    {0xC0, 2, {0x11, 0x04}, 0},
+    {0xC1, 4, {0x69, 0x69, 0x69, 0x69}, 0},
+    {0xC2, 4, {0x19, 0x19, 0x19, 0x19}, 0},
+    {0xC4, 4, {0x4B, 0x4B, 0x4B, 0x4B}, 0},
+    {0xC5, 4, {0x19, 0x19, 0x19, 0x19}, 0},
+    {0xD8, 2, {0x80, 0xE9}, 0},
+    {0xB2, 1, {0x02}, 0},
+    {0xB3, 10, {0xE5, 0xF6, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45}, 0},
+    {0xB4, 8, {0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45}, 0},
+    {0x62, 3, {0x32, 0x03, 0x1F}, 0},
+    {0xB7, 1, {0x13}, 0},
+    {0xB0, 1, {0x64}, 0},
+    {0x11, 0, {}, 200},  // sleep out
+    {0xC9, 1, {0x00}, 0},
+    {0x36, 1, {0x48}, 0},  // memory data access control
+    {0x3A, 1, {0x11}, 0},  // data format: 4-pixel blocks
+    {0xB9, 1, {0x20}, 0},
+    {0xB8, 1, {0x29}, 0},
+    {0x21, 0, {}, 0},  // display inversion on
+    {0x2A, 2, {0x12, 0x2A}, 0},  // CASET: 25 column bands of 12 pixels
+    {0x2B, 2, {0x00, 0xC7}, 0},  // RASET: 200 rows of 2-pixel pairs
+    {0x35, 1, {0x00}, 0},  // tearing-effect line on
+    {0xD0, 1, {0xFF}, 0},
+    {0x38, 0, {}, 0},  // high power mode
+    {0x29, 0, {}, 0},  // display on
+};
+
+// GRAM window for 400x300: 25 column bands of 12 pixels (0x12..0x2A) x 200 rows (0x00..0xC7)
+// x 3 bytes per address = 15,000 bytes. Also part of kInit; re-sent before every frame.
+constexpr uint8_t kCaset[] = {0x12, 0x2A};
+constexpr uint8_t kRaset[] = {0x00, 0xC7};
+
+}  // namespace
+
+uint32_t St7305Driver::spiHz() const {
+  const uint32_t hz = BoardConfig::ACTIVE.displaySpiHz;
+  return hz ? hz : 10000000u;
+}
+
+PanelGeometry St7305Driver::geometry() const {
+  const auto& p = BoardConfig::ACTIVE;
+  PanelGeometry g;
+  g.width = p.displayWidth;
+  g.height = p.displayHeight;
+  g.widthBytes = p.displayWidth / 8;
+  g.bufferSize = static_cast<uint32_t>(g.widthBytes) * g.height;
+  return g;
+}
+
+void St7305Driver::writeCmd(uint8_t cmd, const uint8_t* data, size_t len) {
+  digitalWrite(dc_, LOW);
+  spi_transaction_t t = {};
+  t.length = 8;
+  t.tx_buffer = &cmd;
+  spi_device_polling_transmit(dev_, &t);
+  if (len) writeData(data, len);
+}
+
+void St7305Driver::writeData(const uint8_t* data, size_t len) {
+  digitalWrite(dc_, HIGH);
+  spi_transaction_t t = {};
+  t.length = len * 8;
+  t.tx_buffer = data;
+  spi_device_polling_transmit(dev_, &t);
+}
+
+void St7305Driver::reset() {
+  digitalWrite(rst_, HIGH);
+  delay(50);
+  digitalWrite(rst_, LOW);
+  delay(20);
+  digitalWrite(rst_, HIGH);
+  delay(150);
+}
+
+void St7305Driver::sendInitSequence() {
+  for (const InitStep& s : kInit) {
+    writeCmd(s.cmd, s.data, s.len);
+    if (s.delayAfterMs) delay(s.delayAfterMs);
+  }
+}
+
+void St7305Driver::begin(EpdBus& /*bus*/) {
+  const auto& pins = BoardConfig::ACTIVE.display;
+  dc_ = pins.dc;
+  rst_ = pins.rst;
+
+  const PanelGeometry g = geometry();
+  const size_t gridLen = st7305::gridBytes(g.width, g.height);
+
+  if (!grid_) {
+    grid_ = static_cast<uint8_t*>(heap_caps_malloc(gridLen, MALLOC_CAP_DMA | MALLOC_CAP_8BIT));
+  }
+
+  if (!busReady_) {
+    spi_bus_config_t bc = {};
+    bc.mosi_io_num = pins.mosi;
+    bc.miso_io_num = -1;
+    bc.sclk_io_num = pins.sclk;
+    bc.quadwp_io_num = -1;
+    bc.quadhd_io_num = -1;
+    bc.max_transfer_sz = static_cast<int>(gridLen);
+    spi_bus_initialize(kHost, &bc, SPI_DMA_CH_AUTO);
+
+    spi_device_interface_config_t dc = {};
+    dc.clock_speed_hz = static_cast<int>(spiHz());
+    dc.mode = 0;
+    dc.spics_io_num = pins.cs;
+    dc.queue_size = 1;
+    spi_bus_add_device(kHost, &dc, &dev_);
+    busReady_ = true;
+  }
+
+  pinMode(dc_, OUTPUT);
+  pinMode(rst_, OUTPUT);
+  reset();
+  sendInitSequence();
+}
+
+void St7305Driver::display(EpdBus& /*bus*/, const uint8_t* fb, const uint8_t* /*prev*/, RefreshMode /*mode*/,
+                           bool /*turnOff*/) {
+  if (!grid_ || !fb) return;
+  const auto& p = BoardConfig::ACTIVE;
+  st7305::packLandscape(fb, grid_, p.displayWidth, p.displayHeight, p.orientation.mirrorX, p.orientation.mirrorY);
+
+  writeCmd(0x2A, kCaset, sizeof(kCaset));
+  writeCmd(0x2B, kRaset, sizeof(kRaset));
+  writeCmd(0x2C);  // memory write; the controller pushes GRAM to the glass on its own scan
+  writeData(grid_, st7305::gridBytes(p.displayWidth, p.displayHeight));
+}
+
+void St7305Driver::deepSleep(EpdBus& /*bus*/) {
+  // The panel is not bistable. Low power mode (1 Hz scan) keeps the image on screen for a
+  // fraction of the high-power current; a full controller sleep would blank it.
+  writeCmd(0x39);
+}
+
+PanelDriver& st7305Driver() {
+  static St7305Driver instance;
+  return instance;
+}
+
+}  // namespace freeink
+
+#endif  // FREEINK_DRIVER_ST7305
diff --git a/libs/display/FreeInkDisplay/src/driver/St7305Driver.h b/libs/display/FreeInkDisplay/src/driver/St7305Driver.h
new file mode 100644
index 0000000..635f040
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/St7305Driver.h
@@ -0,0 +1,56 @@
+#pragma once
+
+// FreeInk SDK: Sitronix ST7305 reflective-LCD panel driver (Waveshare ESP32-S3-RLCD-4.2).
+//
+// An EXTERNAL-BUS driver: it owns its SPI bus end to end (usesExternalBus() == true), so the
+// facade leaves EpdBus down, like LgfxEpdDriver / It8951Driver. The panel is a reflective LCD,
+// not e-paper: there is no BUSY line and no waveform choice, so every RefreshMode is the same
+// full-frame flush (15,000 bytes at 10 MHz is ~12 ms of SPI plus the pack).
+//
+// Place this file next to PanelDriver.h.
+
+#include <BoardConfig.h>
+
+#if FREEINK_DRIVER_ST7305
+
+#include <driver/spi_master.h>
+
+#include "PanelDriver.h"
+#include "St7305Frame.h"
+
+namespace freeink {
+
+class St7305Driver final : public PanelDriver {
+ public:
+  const char* controllerName() const override { return "ST7305"; }
+
+  uint32_t spiHz() const override;
+  // No BUSY pin on this panel; value is never consulted for an external-bus driver.
+  BusyPolarity busyPolarity() const override { return static_cast<BusyPolarity>(0); }
+  PanelGeometry geometry() const override;
+  bool usesExternalBus() const override { return true; }
+
+  void begin(EpdBus& bus) override;
+  void deepSleep(EpdBus& bus) override;
+
+  void display(EpdBus& bus, const uint8_t* fb, const uint8_t* prev, RefreshMode mode, bool turnOff) override;
+  // A windowed update buys nothing at 15 KB per frame; the base class falls back to a full
+  // flush, which is exactly what we want.
+
+ private:
+  void reset();
+  void writeCmd(uint8_t cmd, const uint8_t* data = nullptr, size_t len = 0);
+  void writeData(const uint8_t* data, size_t len);
+  void sendInitSequence();
+
+  spi_device_handle_t dev_ = nullptr;
+  bool busReady_ = false;
+  uint8_t* grid_ = nullptr;  // DMA-capable GRAM image, gridBytes(w, h)
+  int8_t dc_ = -1, rst_ = -1;
+};
+
+PanelDriver& st7305Driver();
+
+}  // namespace freeink
+
+#endif  // FREEINK_DRIVER_ST7305
diff --git a/libs/display/FreeInkDisplay/src/driver/St7305Frame.h b/libs/display/FreeInkDisplay/src/driver/St7305Frame.h
new file mode 100644
index 0000000..2139934
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/St7305Frame.h
@@ -0,0 +1,58 @@
+#pragma once
+
+// FreeInk SDK: ST7305 frame packer (pure, no hardware, host-testable).
+//
+// Converts the facade's row-major 1-bit framebuffer into the ST7305 GRAM layout used by the
+// Waveshare ESP32-S3-RLCD-4.2 (landscape, 2x4-pixel blocks, one byte per block).
+//
+//   facade fb : row-major, `w/8` bytes per row, MSB = leftmost pixel, bit 1 = white
+//   grid      : (w/2) columns of (h/4) bytes; index = (x>>1) * (h/4) + ((h-1-y)>>2)
+//               bit  = 7 - (((h-1-y)&3) << 1 | (x&1)); bit 1 = white
+//
+// The mapping matches Waveshare's RLCD_SetLandscapePixel as reproduced in three independent
+// third-party ports (a MicroPython driver, an ESPHome component and an ESP-IDF project). Each
+// pixel owns exactly one bit, so there is no read-modify-write.
+//
+// Requires w % 8 == 0 (framebuffer rows are whole bytes) and h % 4 == 0.
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace freeink {
+namespace st7305 {
+
+// Flip if a bench test shows the image inverted (white on black).
+constexpr bool kInvertOutput = false;
+
+constexpr size_t gridBytes(uint16_t w, uint16_t h) { return static_cast<size_t>(w / 2) * (h / 4); }
+
+// `out` must hold gridBytes(w, h) bytes. mirrorX/mirrorY apply a panel mount transform to the
+// SOURCE coordinates (BoardProfile::orientation).
+inline void packLandscape(const uint8_t* fb, uint8_t* out, uint16_t w, uint16_t h, bool mirrorX, bool mirrorY) {
+  const uint16_t stride = w / 8;
+  const uint16_t cols = w / 2;
+  const uint16_t blocks = h / 4;
+  for (uint16_t bx = 0; bx < cols; ++bx) {
+    uint8_t* col = out + static_cast<size_t>(bx) * blocks;
+    for (uint16_t by = 0; by < blocks; ++by) {
+      uint8_t b = 0;
+      for (uint8_t ly = 0; ly < 4; ++ly) {
+        // GRAM row index counts up from the BOTTOM of the panel (inv_y), so panel row y is
+        // h-1-(by*4+ly).
+        const uint16_t y = static_cast<uint16_t>(h - 1 - (by * 4 + ly));
+        const uint16_t sy = mirrorY ? static_cast<uint16_t>(h - 1 - y) : y;
+        const uint8_t* row = fb + static_cast<size_t>(sy) * stride;
+        for (uint8_t lx = 0; lx < 2; ++lx) {
+          const uint16_t x = static_cast<uint16_t>(bx * 2 + lx);
+          const uint16_t sx = mirrorX ? static_cast<uint16_t>(w - 1 - x) : x;
+          const uint8_t px = (row[sx >> 3] >> (7 - (sx & 7))) & 1u;
+          b |= static_cast<uint8_t>(px << (7 - ((ly << 1) | lx)));
+        }
+      }
+      col[by] = kInvertOutput ? static_cast<uint8_t>(~b) : b;
+    }
+  }
+}
+
+}  // namespace st7305
+}  // namespace freeink
